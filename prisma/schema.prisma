generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  // Use the default (node_modules/.prisma/client). Do not point to @prisma/client directly.
  // Prisma will forward imports from @prisma/client to this generated client.
  // output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Song {
  title        String
  artist       String?
  youtubeUrl   String
  level        String?
  levelValue   Int?     @db.SmallInt
  scoreEntries String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gameSongId   String   @id
  creatorName  String?
  scoreTxt     String?

  @@index([title])
  @@index([artist])
  @@index([levelValue])
  @@map("song")
}

// Public Song contains the approved version. Submissions are deleted atomically on publication.
model ChartSubmission {
  id              String   @id @db.Uuid
  editTokenHash   String
  creatorName     String
  title           String
  artist          String?
  level           String?
  youtubeUrl      String
  txtContent      String
  notes           String   @default("")
  status          String   @default("pending")
  revision        Int      @default(1)
  gameSongId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([gameSongId])
  @@index([status, updatedAt])
  @@map("chart_submission")
}

model SubmissionQuota {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("submission_quota")
}
